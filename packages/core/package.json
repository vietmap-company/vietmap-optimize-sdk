{
  "name": "@vietmap/optimize-sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic SDK for the Fleetwork Optimize API (VROOM-style vehicle routing). Runs in the browser, Node, and any framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": { "access": "public" },
  "author": "VietMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietmap-company/vietmap-optimize-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vietmap-company/vietmap-optimize-sdk#readme",
  "bugs": "https://github.com/vietmap-company/vietmap-optimize-sdk/issues",
  "engines": { "node": ">=18" },
  "keywords": ["vietmap","fleetwork","optimize","vrp","vehicle-routing","route-optimization","sdk"],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~6.0.2"
  }
}
