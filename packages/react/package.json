{
  "name": "@vietmap/optimize-sdk-react",
  "version": "0.1.0",
  "description": "React bindings for @vietmap/optimize-sdk — FleetworkProvider + useOptimize.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": { "access": "public" },
  "author": "VietMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietmap-company/vietmap-optimize-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/vietmap-company/vietmap-optimize-sdk#readme",
  "bugs": "https://github.com/vietmap-company/vietmap-optimize-sdk/issues",
  "engines": { "node": ">=18" },
  "keywords": ["vietmap","fleetwork","optimize","vrp","react","sdk"],
  "peerDependencies": { "react": ">=16.8.0", "react-dom": ">=16.8.0" },
  "dependencies": {
    "@vietmap/optimize-sdk": "workspace:*",
    "@vietmap/optimize-sdk-elements": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "~6.0.2"
  }
}
